# Copy to .env and fill in. Every DocFlow setting uses the DOCFLOW_ prefix.

# --- LLM ---------------------------------------------------------------
# claude | gemini | fake  (fake = no API calls; everything lands in needs_review)
DOCFLOW_LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
DOCFLOW_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (leave empty to omit the parameter)
DOCFLOW_CLAUDE_EFFORT=medium
# Server-side refusal fallback (skipped automatically for Haiku models)
DOCFLOW_CLAUDE_FALLBACKS=true

GEMINI_API_KEY=
DOCFLOW_GEMINI_MODEL=gemini-2.5-flash

# Optional JSON price overrides in USD per 1M tokens: {"model-id": [input, output]}
# DOCFLOW_PRICE_OVERRIDES={"gemini-2.5-flash": [0.30, 2.50]}

# --- API ---------------------------------------------------------------
# Required header X-API-Key for every /v1 route. Leave empty only for local dev.
DOCFLOW_API_KEY=change-me
DOCFLOW_PUBLIC_BASE_URL=http://localhost:8000

# --- Database ----------------------------------------------------------
# docker-compose sets this for you; Render injects DATABASE_URL.
DOCFLOW_DATABASE_URL=postgresql+psycopg://docflow:docflow@localhost:5432/docflow
POSTGRES_PASSWORD=docflow

# --- Validation / review ----------------------------------------------
DOCFLOW_REVIEW_CONFIDENCE_THRESHOLD=0.80
DOCFLOW_AMOUNT_TOLERANCE=0.02

# --- Notifications (n8n) ----------------------------------------------
# DocFlow POSTs events here; the n8n "DocFlow Notify" workflow fans them out.
DOCFLOW_NOTIFY_WEBHOOK_URL=http://n8n:5678/webhook/docflow-notify
DOCFLOW_NOTIFY_SECRET=change-me-too
# all | issues | none   (batch summaries are always sent unless "none")
DOCFLOW_NOTIFY_ON=issues
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=docflow@example.com

# --- Google Sheets export (optional) -----------------------------------
DOCFLOW_SHEETS_ENABLED=false
DOCFLOW_SHEETS_SPREADSHEET_ID=
DOCFLOW_GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json

# --- n8n ---------------------------------------------------------------
N8N_ENCRYPTION_KEY=generate-a-long-random-string
GENERIC_TIMEZONE=UTC
