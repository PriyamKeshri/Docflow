          },
          {
            "node": "Any failures?",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Any failures?": {
      "main": [
        [
          {
            "node": "Email failures",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
